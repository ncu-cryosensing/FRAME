{
  "checks": [

    {
      "id": "title_word_count",
      "field": "title",
      "type": "wordCount",
      "min": 4,
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "The title contains {count} words. Meets the minimum recommended value of 4.",
      "failureMsg": "The title contains {count} words. Minimum required is 4."
    },

    {
      "id": "creator_exists",
      "field": "authors",
      "type": "arrayNotEmpty",
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "One creator is present.",
      "failureMsg": "Creator is missing."
    },

    {
      "id": "creator_identifier_exists",
      "field": "authors",
      "type": "arrayNotEmpty",
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "{x_orcid} out of {x_people} people have provided an ORCID.",
      "failureMsg": "Creator identifier is missing."
    },

    {
      "id": "creator_affiliation_exists",
      "field": "authors",
      "type": "arrayNotEmpty",
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "Creator affiliation is present.",
      "failureMsg": "Creator affiliation is missing."
    },

    {
      "id": "publication_date_exists",
      "field": "publicationDate",
      "type": "exists",
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "A publication date is present.",
      "failureMsg": "A publication date is missing."
    },

    {
      "id": "doi_exists_findable",
      "field": "doi",
      "type": "exists",
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "The digital object identifier {value} is present.",
      "failureMsg": "Digital object identifier is missing."
    },

    {
      "id": "short_description_word_count",
      "field": "short_description",
      "type": "wordCount",
      "min": 20,
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "Short Description has {count} words. Meets the minimum recommended value of 20.",
      "failureMsg": "Short Description has {count} words. Minimum recommended is 20."
    },
    

    {
      "id": "documentation_word_count_findable",
      "field": "documentation",
      "type": "wordCount",
      "min": 100,
      "level": "REQUIRED",
      "principle": "Findable",
      "successMsg": "Full description has {count} words. Meets the minimum recommended value of 100.",
      "failureMsg": "Full Description has {count} words. Minimum recommended is 100."
    },

    {
      "id": "spatial_extent_exists",
      "field": "spatialExtent",
      "type": "exists",
      "level": "OPTIONAL",
      "principle": "Findable",
      "successMsg": "A spatial extent is present.",
      "failureMsg": "The spatial extent is missing."
    },
{
    "id": "index_page_ai_quality",
    "field": "index_page",
    "type": "aiQuality3",
    "expected": "Good",
    "level": "OPTIONAL",
    "principle": "Findable",
    "successMsg": "[AI check] Host repository that is indexed by search engine.",
    "failureMsg": "[AI check] Host repository that is not indexed by search engine."
  },


    
    {
      "id": "doi_exists_accessible",
      "field": "doi",
      "type": "exists",
      "level": "REQUIRED",
      "principle": "Accessible",
      "successMsg": "The digital object identifier {value} is valid, accessible, and correctly points to the dataset.",
      "failureMsg": "No digital object identifier {value} is invalid, inaccessible, or does not correctly point to the dataset."
    },

    {
      "id": "landing_page_url",
      "field": "url_page",
      "type": "valid",
      "level": "REQUIRED",
      "principle": "Accessible",
      "successMsg": "A resource landing page URL {validvalue} is valid, accessible, and correctly points to the dataset.",
      "failureMsg": "The resource landing page URL {validvalue} is invalid, inaccessible, or does not correctly point to the dataset."
    },

    {
      "id": "download_url",
