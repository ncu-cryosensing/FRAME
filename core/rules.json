      "failureMsg": "A downloading url {urlvalue} is inaccessible."
    },

    {
    "id": "doc_language_ai_quality",
    "field": "doc_language",
    "type": "aiQuality3",
    "expected": "Good",
    "level": "OPTIONAL",
    "principle": "Interoperable",
    "successMsg": "[AI check]Full description is provided using a language with a formal specification.",
